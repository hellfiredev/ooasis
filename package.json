{
  "name": "ooasis",
  "displayName": "Ooasis",
  "description": "AI harness that does nothing",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.136.0"
  },
  "license": "MIT",
  "categories": [
    "AI",
    "Chat"
  ],
  "icon": "images/icon.png",
  "publisher": "hellfiredev",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Ooasis requires workspace trust to access files, run terminal commands, and use workspace-configured LLM endpoints."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ooasis.askAI",
        "title": "Ooasis: Add Selection to Chat"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ooasis.askAI",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "ooasis-sidebar",
          "title": "Ooasis",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "ooasis-sidebar": [
        {
          "type": "webview",
          "id": "ooasis-chat-view",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Ooasis",
      "properties": {
        "ooasis.apiHost": {
          "type": "string",
          "scope": "machine",
          "default": "http://127.0.0.1:1234",
          "description": "The API host for the LLM."
        },
        "ooasis.maxAgentIterations": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "The maximum number of agent iterations per request."
        },
        "ooasis.maxContinuations": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "description": "The maximum number of continuations when a response is truncated."
        },
        "ooasis.history.maxSessions": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "description": "Maximum number of saved chat sessions per workspace. Oldest are deleted first. 0 = unlimited."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:webview": "cd webview-ui && npm run build",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "npm run build:webview && tsc --noEmit && npm run esbuild -- --minify",
    "compile:tests": "tsc -p ./",
    "watch": "npm run esbuild-watch",
    "pretest": "npm run compile && npm run compile:tests && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hellfiredev/ooasis.git"
  },
  "bugs": {
    "url": "https://github.com/hellfiredev/ooasis/issues"
  },
  "homepage": "https://github.com/hellfiredev/ooasis#readme",
  "keywords": [
    "ai",
    "assistant",
    "chat",
    "llm",
    "agent",
    "local-ai",
    "lm-studio",
    "ollama"
  ],
  "author": "hellfiredev"
}
